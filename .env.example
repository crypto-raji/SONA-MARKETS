# ==========================================================================
# SONA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in real values.
# ==========================================================================

# ── Firebase (Auth + Firestore) ────────────────────────────────────────────
# https://console.firebase.google.com → your project → Web app → SDK config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Finnhub (Live stock & market prices) ──────────────────────────────────
# Free tier at https://finnhub.io
VITE_FINNHUB_API_KEY=your-finnhub-api-key

# ── Groq / AI Assistant ───────────────────────────────────────────────────
# Free API key at https://console.groq.com
VITE_GROQ_API_KEY=your-groq-api-key
VITE_SONA_API_URL=

# ── Solana Configuration ───────────────────────────────────────────────────
# Network: 'mainnet-beta' or 'devnet'
VITE_SOLANA_NETWORK=mainnet-beta
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Solana Smart Contract Program IDs ──────────────────────────────────────
VITE_TRADING_PROGRAM_ID_MAINNET=
VITE_TRADING_PROGRAM_ID_DEVNET=
VITE_TRADING_PROGRAM_ID_TESTNET=
VITE_TRANSFER_PROGRAM_ID_MAINNET=
VITE_TRANSFER_PROGRAM_ID_DEVNET=
VITE_TRANSFER_PROGRAM_ID_TESTNET=

# ── Platform Fees & Treasury ──────────────────────────────────────────────
VITE_PLATFORM_FEE_RECIPIENT=

# ── Backend / API Gateway ──────────────────────────────────────────────────
VITE_BACKEND_URL=

# ── Mode Flags ────────────────────────────────────────────────────────────
VITE_DEMO_MODE=false
